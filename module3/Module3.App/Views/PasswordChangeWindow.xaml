<Window x:Class="Module3.App.Views.PasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля"
        Width="440" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="24">
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Смена пароля" Style="{StaticResource HeaderLabel}" />
                <TextBlock Text="При первом входе по выданному паролю требуется задать новый. Все поля обязательны."
                           Style="{StaticResource SubtitleLabel}" />

                <TextBlock Text="Текущий пароль" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="CurrentInput" />

                <TextBlock Text="Новый пароль" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="NewInput" />

                <TextBlock Text="Подтверждение нового пароля" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="ConfirmInput" />

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            x:Name="ChangeButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Изменить пароль"
                            Margin="0,0,6,0"
                            Click="OnChangeClick" />
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Content="Отмена"
                            Margin="6,0,0,0"
                            Click="OnCancelClick" />
                </Grid>

                <TextBlock x:Name="MessageText"
                           Style="{StaticResource StatusInfo}"
                           Text=""
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
