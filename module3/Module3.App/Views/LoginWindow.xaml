<Window x:Class="Module3.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация — Транспортная компания"
        Width="420" Height="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Closed="OnClosed">
    <Grid Margin="24">
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>
                <TextBlock Text="Вход в систему" Style="{StaticResource HeaderLabel}" />
                <TextBlock Text="Введите ваш логин и пароль для доступа в систему."
                           Style="{StaticResource SubtitleLabel}" />

                <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LoginInput"
                         TabIndex="0"
                         KeyDown="OnInputKeyDown" />

                <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordInput"
                             TabIndex="1"
                             KeyDown="OnInputKeyDown" />

                <Button x:Name="SignInButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="Войти"
                        Margin="0,20,0,0"
                        Click="OnSignInClick"
                        TabIndex="2" />

                <TextBlock x:Name="MessageText"
                           Style="{StaticResource StatusInfo}"
                           Margin="0,12,0,0"
                           Text="" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
